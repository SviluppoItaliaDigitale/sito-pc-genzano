{{- /*
  Feed RSS 2.0 dei comunicati stampa (/sala-stampa/comunicati/index.xml).
  Come _default/rss.xml (50 voci, pubDate solo con una data reale,
  lastBuildDate = ultima modifica fra le voci, niente <author>), ma con
  titolo e descrizione in italiano, il sottotitolo del comunicato come
  descrizione della voce e il PDF come <enclosure> (dimensione letta al build).
*/ -}}
{{- $limit := 50 -}}
{{- $pages := .RegularPages.ByDate.Reverse | first $limit -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }} – {{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>I comunicati stampa del {{ site.Params.author | default "Gruppo Comunale Volontari di Protezione Civile di Genzano di Roma" }}.</description>
    <language>{{ site.Language.LanguageCode }}</language>
    {{- with site.Copyright }}
    <copyright>{{ . }}</copyright>
    {{- end }}
    {{- $ultima := time.AsTime "0001-01-01" -}}
    {{- range $pages }}{{ with .Lastmod }}{{ if gt . $ultima }}{{ $ultima = . }}{{ end }}{{ end }}{{ end -}}
    {{- if gt $ultima (time.AsTime "0001-01-02") }}
    <lastBuildDate>{{ $ultima.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      {{- $d := .Date }}{{ if $d.IsZero }}{{ $d = .Lastmod }}{{ end }}
      {{- if not $d.IsZero }}
      <pubDate>{{ $d.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ with .Params.sottotitolo }}{{ . }}{{ else }}{{ .Description }}{{ end }}</description>
      {{- with .Params.pdf }}
      {{- $f := printf "static%s" . }}
      {{- if fileExists $f }}
      <enclosure url="{{ strings.TrimPrefix "/" . | absURL }}" length="{{ (os.Stat $f).Size }}" type="application/pdf" />
      {{- end }}
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
