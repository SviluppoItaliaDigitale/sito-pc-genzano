{{- /* Niente changefreq e priority (audit esterno del 07/10/2026): Google li
       ignora e Bing li tratta come indizi deboli, mentre i valori per sezione
       davano l'impressione di una gerarchia che i motori non usano. Restano
       loc e lastmod (data dell'ultima modifica in git), l'unico segnale utile.
       I campi sitemap.priority nel frontmatter di alcune pagine non hanno più
       effetto. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- $prodBase := .Site.Params.productionBaseURL | default .Site.BaseURL -}}
  {{- $basePath := (urls.Parse .Site.BaseURL).Path | default "/" -}}
  {{- range .Data.Pages -}}
  {{/* Escludi le pagine taxonomy auto-generate (/badges/ + /badges/<termine>/):
       thin content non indicizzato — coerente con il noindex in baseof.html. */}}
  {{- if and (not .Params.noindex) (ne .Kind "taxonomy") (ne .Kind "term") }}
  {{- $pagePath := strings.TrimPrefix $basePath .RelPermalink -}}
  <url>
    <loc>{{ printf "%s/%s" (strings.TrimRight "/" $prodBase) $pagePath | safeHTML }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
  {{/* AUTO-DISCOVERY delle URL statiche (vivono in /static/, non note ad Hugo).
       La convenzione del sito è: TUTTI i contenuti sono indicizzabili di default
       (robots index,follow). Eventuali esclusioni si fanno a livello di file
       singolo modificando la meta robots. Le directory iterate qui sotto
       NON richiedono manutenzione: aggiungendo una nuova sottocartella con
       index.html, comparirà automaticamente nel sitemap al prossimo build. */}}

  {{- /* 1. Schede stampabili: le sottocartelle di /static/formazione/schede-stampabili/
       che hanno un index.html indicizzabile. Escluse (audit 25/09/2026, F22):
       le cartelle senza index.html (es. pacchetti/, che risponde 403) e le
       pagine di reindirizzamento o noindex (canonical verso un'altra pagina):
       in sitemap vanno solo URL canoniche che rispondono 200. */ -}}
  {{- with os.ReadDir "static/formazione/schede-stampabili" }}
    {{- range . }}
      {{- $idx := printf "static/formazione/schede-stampabili/%s/index.html" .Name }}
      {{- $ok := false }}
      {{- if and .IsDir (ne .Name "assets") (fileExists $idx) }}
        {{- $c := readFile $idx }}
        {{- $ok = not (or (findRE `<meta[^>]+name="robots"[^>]+noindex` $c 1) (findRE `http-equiv="refresh"` $c 1)) }}
      {{- end }}
      {{- if $ok }}
  <url>
    <loc>{{ printf "%s/formazione/schede-stampabili/%s/" (strings.TrimRight "/" $prodBase) .Name | safeHTML }}</loc>
  </url>
      {{- end }}
    {{- end }}
  {{- end }}

  {{- /* 2. Giochi (tre fasce): sottocartelle di /static/giochi/<fascia>/ tranne 'assets' */ -}}
  {{- range slice "infanzia" "primaria" "ragazzi" }}
    {{- $fascia := . }}
    {{- with os.ReadDir (printf "static/giochi/%s" $fascia) }}
      {{- range . }}
        {{- if and .IsDir (ne .Name "assets") }}
  <url>
    <loc>{{ printf "%s/giochi/%s/%s/" (strings.TrimRight "/" $prodBase) $fascia .Name | safeHTML }}</loc>
  </url>
        {{- end }}
      {{- end }}
    {{- end }}
  {{- end }}

  {{- /* 3. Abili a Proteggere: sottocartelle di /static/abili-a-proteggere/ */ -}}
  {{- with os.ReadDir "static/abili-a-proteggere" }}
    {{- range . }}
      {{- if and .IsDir (ne .Name "assets") }}
  <url>
    <loc>{{ printf "%s/abili-a-proteggere/%s/" (strings.TrimRight "/" $prodBase) .Name | safeHTML }}</loc>
  </url>
      {{- end }}
    {{- end }}
  {{- end }}

  {{- /* 4. Listing pages (hub) — non sono Hugo content, dichiarate qui.
       monitor/ è la Sala situazioni, dal 21/10/2026: pagina pubblica, collegata da
       /strumenti/, con il suo canonical, ma fino a quel giorno fuori dalla mappa. */ -}}
  {{- range slice "giochi/" "giochi/infanzia/" "giochi/primaria/" "giochi/ragazzi/" "abili-a-proteggere/" "formazione/schede-stampabili/" "quizpc/" "formazionepc/" "monitor/" }}
  <url>
    <loc>{{ printf "%s/%s" (strings.TrimRight "/" $prodBase) . | safeHTML }}</loc>
  </url>
  {{- end }}

  {{- /* 5. Quiz Formativo PC e Formazione PC: file .html (non directory).
       index.html è escluso: la stessa pagina è già elencata con lo slash
       finale fra gli hub (punto 4), e /quizpc/index.html reindirizza.
       Escluse anche le pagine noindex: quiz in corso, esito e allenamento
       funzionano solo dentro una sessione e senza dati tornano all'inizio. */ -}}
  {{- range slice "quizpc" "formazionepc" }}
    {{- $dir := . }}
    {{- with os.ReadDir (printf "static/%s" $dir) }}
      {{- range . }}
        {{- $f := printf "static/%s/%s" $dir .Name }}
        {{- if and (not .IsDir) (strings.HasSuffix .Name ".html") (ne .Name "index.html") (not (findRE `<meta[^>]+name="robots"[^>]+noindex` (readFile $f) 1)) }}
  <url>
    <loc>{{ printf "%s/%s/%s" (strings.TrimRight "/" $prodBase) $dir .Name | safeHTML }}</loc>
  </url>
        {{- end }}
      {{- end }}
    {{- end }}
  {{- end }}

  {{- /* 6-8 (dal 21/10/2026). Fino a quel giorno storie, schede dei kit calamità e
       moduli per le scuole non erano in questa mappa, pur essendo pagine indicizzabili
       e linkate dal sito. Stessi filtri della sezione 1: niente noindex, niente
       rimandi, e solo pagine con un <head> (non frammenti). */ -}}

  {{- /* 6. Storie e racconti: l'indice della biblioteca e una pagina per storia. */ -}}
  {{- $storie := "static/formazione/storie-e-racconti" }}
  {{- if fileExists (printf "%s/index.html" $storie) }}
  <url>
    <loc>{{ printf "%s/formazione/storie-e-racconti/" (strings.TrimRight "/" $prodBase) | safeHTML }}</loc>
  </url>
  {{- end }}
  {{- with os.ReadDir $storie }}
    {{- range . }}
      {{- $idx := printf "%s/%s/index.html" $storie .Name }}
      {{- $ok := false }}
      {{- if and .IsDir (ne .Name "assets") (fileExists $idx) }}
        {{- $c := readFile $idx }}
        {{- $ok = and (findRE `(?i)<head` $c 1) (not (or (findRE `<meta[^>]+name="robots"[^>]+noindex` $c 1) (findRE `http-equiv="refresh"` $c 1))) }}
      {{- end }}
      {{- if $ok }}
  <url>
    <loc>{{ printf "%s/formazione/storie-e-racconti/%s/" (strings.TrimRight "/" $prodBase) .Name | safeHTML }}</loc>
  </url>
      {{- end }}
    {{- end }}
  {{- end }}

  {{- /* 7. Schede dei kit calamità: i file .html delle cartelle kit-calamita-*
       (le pagine dei kit sono di Hugo e stanno già sopra). */ -}}
  {{- with os.ReadDir "static/formazione" }}
    {{- range . }}
      {{- if and .IsDir (strings.HasPrefix .Name "kit-calamita-") }}
        {{- $kit := .Name }}
        {{- range os.ReadDir (printf "static/formazione/%s" $kit) }}
          {{- if and (not .IsDir) (strings.HasSuffix .Name ".html") (ne .Name "index.html") }}
            {{- $c := readFile (printf "static/formazione/%s/%s" $kit .Name) }}
            {{- if and (findRE `(?i)<head` $c 1) (not (or (findRE `<meta[^>]+name="robots"[^>]+noindex` $c 1) (findRE `http-equiv="refresh"` $c 1))) }}
  <url>
    <loc>{{ printf "%s/formazione/%s/%s" (strings.TrimRight "/" $prodBase) $kit .Name | safeHTML }}</loc>
  </url>
            {{- end }}
          {{- end }}
        {{- end }}
      {{- end }}
    {{- end }}
  {{- end }}

  {{- /* 8. Moduli per le scuole: static/scuole/<pacchetto>/<modulo>/index.html. */ -}}
  {{- with os.ReadDir "static/scuole" }}
    {{- range . }}
      {{- if .IsDir }}
        {{- $pacchetto := .Name }}
        {{- range os.ReadDir (printf "static/scuole/%s" $pacchetto) }}
          {{- $idx := printf "static/scuole/%s/%s/index.html" $pacchetto .Name }}
          {{- if and .IsDir (fileExists $idx) }}
            {{- $c := readFile $idx }}
            {{- if and (findRE `(?i)<head` $c 1) (not (or (findRE `<meta[^>]+name="robots"[^>]+noindex` $c 1) (findRE `http-equiv="refresh"` $c 1))) }}
  <url>
    <loc>{{ printf "%s/scuole/%s/%s/" (strings.TrimRight "/" $prodBase) $pacchetto .Name | safeHTML }}</loc>
  </url>
            {{- end }}
          {{- end }}
        {{- end }}
      {{- end }}
    {{- end }}
  {{- end }}
</urlset>
